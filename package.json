{
  "name": "tire-factory-digital-twin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Interactive Tire Factory Digital Twin — APS / MRP / Theory of Constraints demonstration engine",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/process-assets.mjs",
    "verify": "node scripts/run-verify.mjs",
    "smoke": "node scripts/run-smoke.mjs",
    "check": "npm run typecheck && npm run verify && npm run smoke"
  },
  "dependencies": {
    "@heroicons/react": "2.1.5",
    "d3": "7.9.0",
    "framer-motion": "11.11.17",
    "lottie-react": "2.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/d3": "7.4.3",
    "@types/jsdom": "21.1.7",
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "autoprefixer": "10.4.20",
    "esbuild": "0.21.5",
    "jsdom": "25.0.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.15",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
